# =============================================================================
# LLM Configuration Environment Variables
# =============================================================================
# This file documents all available environment variables for configuring
# LLM clients and their generation parameters.
#
# Copy this file to .env and fill in your actual values.
# =============================================================================

# -----------------------------------------------------------------------------
# Gemini Configuration
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash

# Gemini Generation Parameters
GEMINI_TEMPERATURE=0.7          # Range: 0.0-2.0 (Default: 0.7)
GEMINI_TOP_P=0.95              # Range: 0.0-1.0 (Default: 0.95)
GEMINI_TOP_K=40                # Range: ≥1 (Default: 40)
GEMINI_MAX_TOKENS=2048         # Range: ≥1 (Default: 2048)

# -----------------------------------------------------------------------------
# LLaMA Configuration
# -----------------------------------------------------------------------------
LLAMA_MODEL_PATH=/path/to/your/model.gguf
LLAMA_MODEL_NAME=llama-3.1-8b-instruct
LLAMA_GPU_LAYERS=1             # Number of layers to run on GPU (0 = CPU only)
LLAMA_CONTEXT_SIZE=2048        # Maximum context window size

# LLaMA Generation Parameters
LLAMA_TEMPERATURE=0.7          # Range: 0.0-2.0 (Default: 0.7)
LLAMA_TOP_P=0.95              # Range: 0.0-1.0 (Default: 0.95)
LLAMA_TOP_K=40                # Range: ≥1 (Default: 40)
LLAMA_MAX_TOKENS=2048         # Range: ≥1 (Default: 2048)

# -----------------------------------------------------------------------------
# Parameter Guide
# -----------------------------------------------------------------------------
#
# TEMPERATURE:
#   Controls randomness in generation
#   - 0.0-0.3: Very focused, deterministic (good for factual tasks, code)
#   - 0.4-0.6: Balanced but consistent (good for Q&A)
#   - 0.7-0.9: Creative but coherent (good for general conversation)
#   - 1.0-2.0: Very creative/random (good for brainstorming, creative writing)
#
# TOP_P (Nucleus Sampling):
#   Controls diversity by probability mass
#   - 0.9: More focused, less diverse
#   - 0.95: Balanced (recommended)
#   - 1.0: Consider all possible tokens
#
# TOP_K:
#   Limits token selection to top K most likely
#   - 10-20: Very focused
#   - 40: Good default
#   - 50-100: More diverse
#
# MAX_TOKENS:
#   Maximum length of generated response
#   - Consider your use case and model context window
#   - Set lower for shorter responses, higher for long-form content
#
# -----------------------------------------------------------------------------
# Common Presets
# -----------------------------------------------------------------------------
#
# For Creative Writing:
#   TEMPERATURE=1.0
#   TOP_P=0.95
#   TOP_K=50
#   MAX_TOKENS=4096
#
# For Code Generation:
#   TEMPERATURE=0.2
#   TOP_P=0.9
#   TOP_K=20
#   MAX_TOKENS=2048
#
# For Factual Q&A:
#   TEMPERATURE=0.3
#   TOP_P=0.9
#   TOP_K=20
#   MAX_TOKENS=1024
#
# For General Conversation:
#   TEMPERATURE=0.7
#   TOP_P=0.95
#   TOP_K=40
#   MAX_TOKENS=2048
#
# -----------------------------------------------------------------------------

